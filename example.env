# --- model server ---
OLLAMASERVER="https://ollama.example.com"
MODEL="gemma4:e4b"
# Optional: only needed when the server is behind HTTP basic auth
OLLAMAUSER="BASICAUTHUSERNAME"
OLLAMAPASS="BASICAUTHPASSWORD"
# Optional: defaults to ~/.nextpage/nextpage.log
LOGPATH=".log"

# --- learning platform ---
# Where course notes go (e.g. a folder in your Obsidian vault). Optional for the
# terminal app (it asks), required for docker compose.
NEXTPAGE_COURSES_DIR="/home/you/Obsidian/Vault/Courses"

# --- web app (./run.sh --web, or docker compose) ---
NEXTPAGE_PASSWORD="change-me"
# Hostname Traefik routes to the app, e.g. learn.example.com (no https://)
WEB_URL="learn.example.com"
# Optional: host folder for course notes (e.g. in your Obsidian vault). Without
# it, notes are kept in the nextpage_courses Docker volume.
#COURSES_PATH="/home/you/Obsidian/Vault/Courses"
# Optional overrides
#TRAEFIK_NETWORK="traefik"
#TRAEFIK_ENTRYPOINT="websecure"
#PUID=1000
#PGID=1000
